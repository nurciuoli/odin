{
  "name": "odin",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "type": "module",
  "workspaces": [
    "packages/*",
    "adapters/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "yarn workspace @odin/desktop dev",
    "dev:core": "node scripts/dev-core.ts",
    "start": "yarn workspace @odin/core start",
    "build:desktop": "yarn build:web && yarn workspace @odin/desktop dist",
    "dev:web": "yarn workspace @odin/web dev",
    "build:web": "yarn workspace @odin/web build",
    "verify:web": "yarn workspace @odin/web verify",
    "typecheck": "yarn typecheck:core && yarn workspace @odin/web type-check",
    "typecheck:core": "tsc -p tsconfig.json --noEmit",
    "test": "yarn test:core && yarn workspace @odin/web test",
    "test:core": "node --test \"packages/core/src/**/*.test.ts\" \"packages/shared/src/**/*.test.ts\" \"adapters/*/src/**/*.test.ts\" \"apps/desktop/src/**/*.test.ts\""
  },
  "resolutions": {
    "vite": "^6.4.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
