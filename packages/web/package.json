{
  "name": "@odin/web",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/build-widgets.mjs",
    "type-check": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "shots": "node scripts/shots.mjs",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "guard": "node scripts/guard.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check . --log-level warn --cache",
    "verify:static": "yarn format:check && yarn type-check && yarn lint && yarn guard",
    "verify:build": "node scripts/build-strict.mjs",
    "verify": "yarn verify:static && yarn test && yarn verify:build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@jupyter-widgets/base": "^6.0.12",
    "@jupyter-widgets/base-manager": "^1.0.13",
    "@jupyter-widgets/controls": "^5.0.13",
    "@odin/shared": "workspace:*",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "happy-dom": "^15.11.7",
    "playwright": "^1.49.1",
    "prettier": "3.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.11",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  }
}
