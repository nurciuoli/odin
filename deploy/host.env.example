# Settings for deploying Odin from this computer to your host. Copy to deploy/host.env.local (gitignored) and edit.
# Read by deploy/deploy.ps1 and deploy/deploy.sh. See docs/hosting.md.

# How ssh reaches the host: its Tailscale machine name (or any ssh-able address).
ODIN_DEPLOY_HOST=my-host

# The account on the host that runs core (see docs/hosting.md, "Create the odin user").
ODIN_DEPLOY_USER=odin

# Port core listens on at 127.0.0.1 on the host.
ODIN_CORE_PORT=8790

# HTTPS port Tailscale Serve uses. 8443 lets it sit beside another service on 443.
ODIN_SERVE_PORT=8443
